erDiagram
    project_budgets ||--o{ budget_lines : "1 : 0..N"
    budget_lines ||--o{ requests : "1 : 0..N"
    areas ||--o{ requests : "area_id FK"
    requests ||--o| payment_events : "1 : 0..1"
    requests ||--|{ request_state_events : "1 : 1..N"
    currencies ||--o{ requests : "currency"
    currencies ||--o{ payment_events : "rate applied"
    suppliers o|--o{ requests : "supplier_id FK"
    peoples o|--o{ requests : "requester_id FK"
    financial_batches ||--|{ batch_projects : "1 : 1..N"
    project_budgets ||--o{ batch_projects : "project_budget_id FK"
    financial_batches ||--|{ batch_items : "1 : 1..N"
    payment_events ||--o{ batch_items : "payment_event_id FK"
    weekly_notification_runs ||--o{ email_deliveries : "1 : 0..N"
    email_recipients ||--o{ email_deliveries : "recipient_id FK"

    project_budgets {
        integer id PK
        string code UK
        string name
        string department
        string last_checkpoint_at
        string created_at
        string updated_at
    }

    areas {
        integer id PK
        string code UK
        string name
        string country_code
        string created_at
        string updated_at
    }

    budget_lines {
        integer id PK
        integer project_budget_id FK
        string code
        string description
        string created_at
        string updated_at
    }

    requests {
        integer id PK
        string submission_key UK
        integer budget_line_id FK
        integer area_id FK
        integer requester_id FK
        integer supplier_id FK
        string request_reference UK
        string po_reference
        string description
        string status
        string currency FK
        numeric amount
        numeric usd
        string procurement_scenario
        integer expected_days
        string due_date
        date order_date
        date po_date
        string remarks
        timestamp registered_at
        timestamp pending_entered_at
    }

    payment_events {
        integer id PK
        integer request_id FK
        integer project_budget_id FK
        integer budget_line_id FK
        date payment_date
        string original_currency
        numeric original_amount
        numeric etb_value
        numeric usd_value
        numeric eur_value
        numeric gbp_value
        string payment_method
        string remarks
        timestamp recorded_at
    }

    request_state_events {
        integer id PK
        integer request_id FK
        string from_status
        string to_status
        real actual_days
        real delay_days
        boolean is_delayed
        timestamp occurred_at
        string remarks
    }

    currencies {
        integer id PK
        string rate_month
        string code
        numeric rate_to_eur
        numeric eur_per_unit
        numeric usd_per_unit
        numeric gbp_per_unit
        numeric etb_per_unit
        integer active
        string source
        string updated_at
    }

    financial_batches {
        integer id PK
        string batch_code UK
        string status
        numeric total_usd
        string remarks
        timestamp prepared_at
        timestamp applied_at
        timestamp abandoned_at
    }

    batch_projects {
        integer id PK
        integer batch_id FK
        integer project_budget_id FK
        boolean is_active
    }

    batch_items {
        integer id PK
        integer batch_id FK
        integer payment_event_id FK
        numeric usd_amount
        boolean is_active
    }

    suppliers {
        integer id PK
        string supplier_name UK
        string email
        string phone
        string notes
        integer active
        string created_at
        string updated_at
    }

    peoples {
        integer id PK
        string full_name
        string email UK
        string department
        integer active
        string created_at
        string updated_at
    }

    email_recipients {
        integer id PK
        string display_name
        string email UK
        boolean active
        timestamp created_at
        timestamp updated_at
        timestamp deactivated_at
    }

    weekly_notification_runs {
        integer id PK
        date period_key UK
        timestamp period_start
        timestamp period_end
        string business_timezone
        time cutoff_local
        timestamp created_at
    }

    email_deliveries {
        integer id PK
        integer run_id FK
        integer recipient_id FK
        string status
        integer attempt_count
        timestamp last_attempt_at
        timestamp accepted_at
        string error_message
        timestamp created_at
        timestamp updated_at
    }

    settings {
        integer id PK
        string business_timezone
        time weekly_cutoff_local
        string default_currency
        string finance_currency
        integer fx_max_age_days
        integer pending_overdue_hours
        integer notification_catchup_hours
        string application_base_url
        bigint data_revision
        timestamp updated_at
    }
