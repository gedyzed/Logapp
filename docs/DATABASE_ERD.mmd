erDiagram
    projects ||--o{ budget_lines : "1 : 0..N"
    budget_lines ||--o{ expenses : "1 : 0..N"
    expenses ||--o| payment_events : "1 : 0..1"
    expenses ||--|{ request_state_events : "1 : 1..N"
    currencies ||--o{ expenses : "currency"
    currencies ||--o{ payment_events : "rate applied"
    suppliers o|--o{ expenses : "supplier"
    people o|--o{ expenses : "requested_by"

    projects {
        integer id PK
        string project_code UK
        string department
        string location
        string last_deducted_at
        string created
        string updated
    }

    budget_lines {
        integer id PK
        integer project_id FK
        string budget_line_code
        string created
        string updated
    }

    expenses {
        integer id PK
        integer budget_line_id FK
        string description
        string order_form
        string po
        string requested_by
        string submitted_by
        string supplier
        string status
        string currency FK
        real amount
        real usd
        real rate_used
        string order_date
        string po_date
        string payment_date
        string remarks
        string created
        string updated
    }

    payment_events {
        integer id PK
        integer expense_id FK, UK
        string payment_date
        string rate_month
        string original_currency
        real original_amount
        real etb_value
        real usd_value
        real eur_value
        real gbp_value
        string recorded_at
    }

    request_state_events {
        integer id PK
        integer expense_id FK
        string from_status
        string to_status
        string occurred_at
        string remarks
    }

    currencies {
        integer id PK
        string rate_month
        string code
        real rate_to_eur
        real eur_per_unit
        real usd_per_unit
        real gbp_per_unit
        real etb_per_unit
        integer active
        string source
        string updated_at
    }

    financial_batches {
        integer id PK
        string batch_code UK
        string batch_name
        string project_codes
        string request_ids
        real total_amount
        string currency
        string status
        string created
        string confirmed_at
    }

    suppliers {
        integer id PK
        string supplier_name UK
        string email
        string phone
        string notes
        integer active
        string created
        string updated
    }

    people {
        integer id PK
        string full_name UK
        string email UK
        string department
        integer active
        string created
        string updated
    }

    notification_emails {
        integer id PK
        string email UK
        integer weekly_report
        integer active
        string last_sent_period
        string last_sent_at
        string last_status
        string last_error
        string created
        string updated
    }

    app_defaults {
        string setting_key PK
        string setting_value
        string updated
    }
